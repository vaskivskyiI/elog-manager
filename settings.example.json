{
  "elogd_cfg": "/usr/local/elog/elogd.cfg",
  "password_file": "/usr/local/elog/passwords.pwd",
  "backup_dir": "/usr/local/elog/cfg-backups",

  "secret_key": "CHANGE-ME: python3 -c 'import secrets; print(secrets.token_hex(32))'",
  "secure_cookies": true,
  "session_hours": 12,

  "manager_admins": ["alice"],
  "allow_logbook_admins": true,
  "allowed_users": [],

  "auth_mode": "password_file",
  "auth_header": "X-Remote-User",

  "elog_url": "https://elog.example.org/",
  "behind_proxy": true,
  "host": "127.0.0.1",
  "port": 8090,
  "keep_backups": 200,
  "reload_mode": "signal",
  "elogd_process": "elogd",
  "reload_command": "sudo -n /usr/bin/killall -HUP elogd"
}
