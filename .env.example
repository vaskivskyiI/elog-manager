# ELOG Manager settings. Used by docker compose (env_file), systemd (EnvironmentFile)
# and `python -m elogmgr` (reads ./.env). Everything else comes from elogd.cfg:
# password file, managers ([global] Admin user), ELOG URL, session length.

# Directory containing elogd.cfg, as elogd.cfg itself refers to it (e.g. "Password file").
ELOG_DIR=/usr/local/elog
# Data directory with the logbooks ("Logbook dir" in elogd.cfg).
ELOG_DATA_DIR=/mnt/elog_data

# Docker only: where these folders are on the host, if elogd runs in a container and its
# folders are mounted from elsewhere (the "*_HOST" settings of the ELOG compose project).
# Leave unset for an elogd that runs on the host: the folders are then mounted at the same path.
# ELOG_DIR_HOST=/home/elog/elog/config
# ELOG_DATA_HOST=/mnt/elog_data
# ELOGD_CFG=/usr/local/elog/elogd.cfg     # only if the file is not $ELOG_DIR/elogd.cfg

# uid/gid that run elogd (id -u elog; id -g elog); Docker runs the manager as this user
ELOG_UID=1000
ELOG_GID=1000

# Port on 127.0.0.1; put your HTTPS reverse proxy in front
ELOGMGR_PORT=8090

# --- optional ------------------------------------------------------------
# ELOGMGR_STATE_DIR=/var/lib/elog-manager   # backups, change log, session key; must be writable.
#   Docker uses its own "state" volume and systemd /var/lib/elog-manager, so normally leave this unset.
# ELOGMGR_RELOAD=signal                            # signal | command | none
# ELOGMGR_RELOAD_COMMAND=sudo -n /usr/bin/killall -HUP elogd
# ELOGMGR_BEHIND_PROXY=1                           # 0 only for plain-http testing
# ELOGMGR_ELOG_URL=https://elog.example.org/       # if elogd.cfg has no "URL"
# ELOGMGR_AUTH_HEADER=X-Remote-User                # trust this header (only if the proxy sets it)
