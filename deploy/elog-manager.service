[Unit]
Description=ELOG Manager (web GUI for elogd.cfg)
After=network.target elogd.service

[Service]
# Same account that owns elogd.cfg and passwords.pwd ("Usr = elog" in elogd.cfg).
# Running as the same user as elogd lets the manager send it SIGHUP to reload.
User=elog
Group=elog
WorkingDirectory=/opt/elog-manager
# systemd creates /var/lib/elog-manager owned by User= (backups, change log, session key)
StateDirectory=elog-manager
Environment=ELOGMGR_STATE_DIR=/var/lib/elog-manager
EnvironmentFile=/opt/elog-manager/.env
ExecStart=/opt/elog-manager/venv/bin/python -m elogmgr
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/usr/local/elog

[Install]
WantedBy=multi-user.target
